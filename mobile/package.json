{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node scripts/prepare-transfer-credentials.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts",
    "doctor": "npx expo-doctor",
    "export:release": "expo export --platform all",
    "build:stores": "npx eas-cli@latest build --platform all --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "eas-build-post-install": "node scripts/prepare-transfer-credentials.mjs --required"
  },
  "dependencies": {
    "@helyon/stadium-transfer": "file:modules/stadium-transfer",
    "@helyon/stadium-usb": "file:modules/stadium-usb",
    "@msgpack/msgpack": "^3.1.3",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "buffer": "^6.0.3",
    "expo": "~58.0.14",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  }
}
