{
  "expo": {
    "name": "HELYON",
    "slug": "helyon",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/helyon-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0c",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBonjourServices": ["_stadiumserver._tcp"],
        "NSLocalNetworkUsageDescription": "Find and edit your Helix Stadium on your local network or through a compatible USB connection.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.beggars.stadium-remote",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/helyon-mark.png",
        "monochromeImage": "./assets/brand/helyon-monochrome.png",
        "backgroundColor": "#161616"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beggars.stadiumremote",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/helyon-mark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0c",
          "android": {
            "imageWidth": 240
          }
        }
      ]
    ],
    "owner": "beggars",
    "extra": {
      "eas": {
        "projectId": "407fa171-3b6b-4c1a-a828-cf2976ca1591"
      }
    }
  }
}
